     if (cnt > 0)
         fix_collisions(priv, last, priv->eimg + cnt - last);
 
+    // Observe final event coordinates without changing the public image chain.
+    if (priv->assglass_event_callback) {
+        for (int i = 0; i < cnt; i++) {
+            size_t count = 0;
+            for (ASS_Image *im = priv->eimg[i].imgs; im; im = im->next)
+                count++;
+            AssglassImageView *views = NULL;
+            if (count <= SIZE_MAX / sizeof(*views))
+                views = count ? malloc(count * sizeof(*views)) : NULL;
+            if (count && !views) {
+                priv->assglass_event_callback(priv->assglass_event_opaque,
