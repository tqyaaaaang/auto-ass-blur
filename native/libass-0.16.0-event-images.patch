--- a/libass/ass.h
+++ b/libass/ass.h
@@ -786,6 +786,31 @@
 #undef ASS_DEPRECATED
 #undef ASS_DEPRECATED_ENUM
 
+/* Assglass read-only event export, extension ABI 1 (not upstream libass).
+ * The callback runs after every layer's collision correction, before event
+ * image chains are joined. Views and bitmap storage are valid only during the
+ * callback. Event indices address the unmodified ASS_Track.events array.
+ * Never reenter, mutate or destroy the renderer/track from this callback.
+ * A descriptor-allocation failure reports event_index=-1, images=NULL and
+ * image_count=SIZE_MAX; standard rendering and change detection still finish.
+ * No callback means no additional allocation or bitmap work.
+ */
+typedef struct AssglassImageView {
+    int type;
+    int dst_x, dst_y;
+    int w, h, stride;
+    uint32_t color;
+    const uint8_t *bitmap;
+} AssglassImageView;
+
+typedef void (*AssglassEventImagesCallback)(
+    void *opaque, const ASS_Track *track, int event_index,
+    const AssglassImageView *images, size_t image_count);
+
+unsigned assglass_event_export_abi_version(void);
+void assglass_set_event_images_callback(ASS_Renderer *renderer,
+    AssglassEventImagesCallback callback, void *opaque);
+
 #ifdef __cplusplus
 }
 #endif
