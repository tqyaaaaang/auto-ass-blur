+                break;
+            }
+            size_t j = 0;
+            for (ASS_Image *im = priv->eimg[i].imgs; im; im = im->next) {
+                views[j++] = (AssglassImageView) {
+                    .type = im->type, .dst_x = im->dst_x, .dst_y = im->dst_y,
+                    .w = im->w, .h = im->h, .stride = im->stride,
+                    .color = im->color, .bitmap = im->bitmap,
+                };
+            }
+            priv->assglass_event_callback(priv->assglass_event_opaque, track,
+                (int)(priv->eimg[i].event - track->events), views, count);
+            free(views);
+        }
+    }
